# Prevent directory listing
Options -Indexes

# URL Rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Don't rewrite actual files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything through router-dev.php
    RewriteRule ^(.*)$ router-dev.php?url=$1 [QSA,L]
</IfModule>

# Security headers are set in inc/security-headers.php (single source of
# truth, supports CSP nonces) Do not duplicate them here, duplicate
# CSP/HSTS headers are enforced as an intersection by browsers and will
# silently break nonce-based inline scripts.